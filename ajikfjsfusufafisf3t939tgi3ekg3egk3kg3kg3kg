			local function refresh_track()
				local ok, data, code = spotify_request("GET", "/me/player/currently-playing")
				if not ok then
					update_status(format_api_error(data), rgb(235, 135, 135))
					return false, data
				end
				if code == 204 or type(data) ~= "table" or type(data.item) ~= "table" then
					title_label.Text = "Nothing playing"
					artist_label.Text = "Start playback in Spotify"
					album_label.Text = ""
					artwork.Image = ""
					track_duration = 0
					track_progress = 0
					is_playing = false
					progress_fill.Size = dim2(0, 0, 1, 0)
					elapsed_label.Text = "0:00"
					duration_label.Text = "0:00"
					toggle_button.Image = play_asset
					update_status("No active Spotify playback")
					return true
				end

				local item = data.item
				local artists = {}
				for _, artist in ipairs(item.artists or {}) do
					if artist.name then table.insert(artists, artist.name) end
				end
				title_label.Text = tostring(item.name or "Unknown track")
				artist_label.Text = table.concat(artists, ", ")
				album_label.Text = tostring(item.album and item.album.name or "")
				local images = item.album and item.album.images or {}
				artwork.Image = images[1] and images[1].url or ""
				track_duration = tonumber(item.duration_ms) or 0
				track_progress = tonumber(data.progress_ms) or 0
				is_playing = data.is_playing == true
				progress_fill.Size = dim2(track_duration > 0 and math.clamp(track_progress / track_duration, 0, 1) or 0, 0, 1, 0)
				elapsed_label.Text = format_clock(track_progress)
				duration_label.Text = format_clock(track_duration)
				toggle_button.Image = is_playing and pause_asset or play_asset
				local device = data.device and data.device.name
				update_status(device and ("Spotify Connect · " .. tostring(device)) or "Spotify Connect", rgb(115, 210, 145))
				return true
			end

