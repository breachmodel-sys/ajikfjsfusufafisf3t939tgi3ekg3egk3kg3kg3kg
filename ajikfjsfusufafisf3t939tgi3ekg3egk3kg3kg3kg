			local function decode_query(value)
				return (value:gsub("%+", " "):gsub("%%(%x%x)", function(hex)
					return string.char(tonumber(hex, 16))
				end))
			end

			local function query_value(url, key)
				local escaped_key = key:gsub("([^%w])", "%%%1")
				local value = url:match("[?&]" .. escaped_key .. "=([^&#]+)")
				return value and decode_query(value) or nil
			end

			local function open_browser(url)
				local openers = {}
				for _, name in ipairs({"open_url", "openurl", "openbrowser"}) do
					local opener = environment[name]
					if type(opener) == "function" then
						table.insert(openers, opener)
					end
				end
				if type(environment.syn) == "table" then
					if type(environment.syn.open) == "function" then
						table.insert(openers, environment.syn.open)
					end
				end
				for _, opener in ipairs(openers) do
					if type(opener) == "function" then
						local ok, result = pcall(opener, url)
						if ok and result ~= false then
							return true
						end
					end
				end
				local ok = pcall(function()
					gui_service:OpenBrowserWindow(url)
				end)
				return ok
			end

			start_authorization = function()
				if client_id == "" then
					update_status("Set SPOTIFY_CLIENT_ID in executor environment first", rgb(235, 135, 135))
					return
				end
				code_verifier = create_verifier()
				local digest, hash_error = hash_sha256(code_verifier)
				if not digest then
					update_status(hash_error, rgb(235, 135, 135))
					return
				end
				oauth_state = http_service:GenerateGUID(false):gsub("-", "")
				local params = {
					client_id = client_id,
					response_type = "code",
					redirect_uri = redirect_uri,
					scope = "user-read-currently-playing user-read-playback-state user-modify-playback-state",
					code_challenge_method = "S256",
					code_challenge = base64url(digest),
					state = oauth_state,
				}
				local url = "https://accounts.spotify.com/authorize?" .. form_encode(params)
				if not open_browser(url) then
					local clipboard = environment.setclipboard or environment.toclipboard
					if type(clipboard) == "function" then
						pcall(clipboard, url)
					end
					update_status("Could not open browser; login URL copied if clipboard is available", rgb(235, 135, 135))
					return
				end
				update_status("Spotify login opened. Paste the redirected URL below when done.", rgb(115, 210, 145))
			end

			finish_login = function()
				local pasted_url = redirect_box.Text
				local code = query_value(pasted_url, "code")
				local auth_error = query_value(pasted_url, "error")
				local returned_state = query_value(pasted_url, "state")
				if auth_error then
					update_status("Spotify authorization failed: " .. auth_error, rgb(235, 135, 135))
					return
				end
				if not code or not code_verifier then
					update_status("Click Connect Spotify, finish browser login, then paste its redirect URL", rgb(235, 135, 135))
					return
				end
				if returned_state ~= oauth_state then
					update_status("OAuth state mismatch. Click Connect Spotify and retry.", rgb(235, 135, 135))
					return
				end
				local token_ok, token_error = exchange_token({
					client_id = client_id,
					grant_type = "authorization_code",
					code = code,
					redirect_uri = redirect_uri,
					code_verifier = code_verifier,
				})
				if not token_ok then
					update_status("Spotify sign-in failed: " .. tostring(token_error), rgb(235, 135, 135))
					return
				end
				code_verifier = nil
				oauth_state = nil
				redirect_box.Text = ""
				update_status("Connected. Checking Spotify playback...", rgb(115, 210, 145))
				refresh_track()
			end

			local player_obj = {}
			if music_panel.items.close then
				music_panel.items.close.MouseButton1Click:Connect(function()
					is_enabled = false
					if player_obj.on_close then player_obj.on_close() end
				end)
			end

			task.spawn(function()
				local next_refresh = 0
				while music_panel.items.sgui.Parent do
					task.wait(1)
					if is_enabled and access_token then
						if is_playing and track_duration > 0 then
							track_progress = math.min(track_duration, track_progress + 1000)
							progress_fill.Size = dim2(math.clamp(track_progress / track_duration, 0, 1), 0, 1, 0)
							elapsed_label.Text = format_clock(track_progress)
						end
						if os.clock() >= next_refresh then
							next_refresh = os.clock() + 4
							local ok, err = pcall(refresh_track)
							if not ok then
								update_status("Spotify update failed: " .. tostring(err), rgb(235, 135, 135))
							end
						end
					end
				end
			end)

			player_obj.panel = music_panel
			player_obj.load_track = function()
				return refresh_track()
			end
			player_obj.connect = start_authorization
			player_obj.set_visible = function(visible)
				music_panel.items.sgui.Enabled = visible
				is_enabled = visible
				if visible and access_token then
					refresh_track()
				end
			end
			return setmetatable(player_obj, library)
		end

