		function library:music_player(options)
			options = options or {}

			local environment = _G
			if type(getgenv) == "function" then
				local ok, value = pcall(getgenv)
				if ok and type(value) == "table" then
					environment = value
				end
			end

			local client_id = options.client_id or environment.SPOTIFY_CLIENT_ID or ""
			local redirect_uri = options.redirect_uri or "http://127.0.0.1:8888/callback"
			local access_token
			local refresh_token
			local token_expires_at = 0
			local code_verifier
			local oauth_state
			local is_enabled = options.open == true
			local is_playing = false
			local track_duration = 0
			local track_progress = 0

			local function request_http(method, url, headers, body)
				local request_function = environment.request or environment.http_request or environment.httprequest
				if not request_function and type(environment.syn) == "table" then
					request_function = environment.syn.request
				end
				if type(request_function) == "function" then
					local ok, response = pcall(request_function, {
						Url = url,
						Method = method,
						Headers = headers or {},
						Body = body,
					})
					if not ok then
						return nil, tostring(response)
					end
					return response
				end
				local ok, response = pcall(function()
					return http_service:RequestAsync({
						Url = url,
						Method = method,
						Headers = headers or {},
						Body = body,
					})
				end)
				if not ok then
					return nil, tostring(response)
				end
				return response
			end

			local function decode_response(response)
				if not response or type(response.Body) ~= "string" or response.Body == "" then
					return nil
				end
				local ok, decoded = pcall(function()
					return http_service:JSONDecode(response.Body)
				end)
				if ok then
					return decoded
				end
				return nil
			end

			local function response_status(response)
				if not response then
					return 0
				end
				return tonumber(response.StatusCode or response.status_code or response.Status) or 0
			end

			local function response_error(response, request_error)
				if request_error then
					return request_error
				end
				local decoded = decode_response(response)
				local status = response_status(response)
				local prefix = status > 0 and ("HTTP " .. tostring(status) .. ": ") or ""
				if type(decoded) == "table" then
					if type(decoded.error) == "table" then
						return prefix .. tostring(decoded.error.message or decoded.error_description or decoded.error.status or "Spotify request failed")
					end
					return prefix .. tostring(decoded.error_description or decoded.error or decoded.message or "Spotify request failed")
				end
				return prefix .. "Spotify request failed"
			end

			local function form_encode(values)
				local parts = {}
				for key, value in pairs(values) do
					table.insert(parts, http_service:UrlEncode(key) .. "=" .. http_service:UrlEncode(tostring(value)))
				end
				return table.concat(parts, "&")
			end

			local function hash_sha256(data)
				local crypto = environment.crypt
				if type(crypto) ~= "table" and type(environment.syn) == "table" then
					crypto = environment.syn.crypt
				end
				if type(crypto) ~= "table" or type(crypto.hash) ~= "function" then
					return nil, "This executor does not expose SHA-256 needed for Spotify PKCE"
				end
				local ok, digest = pcall(crypto.hash, data, "sha256")
				if not ok or type(digest) ~= "string" then
					return nil, "Executor SHA-256 failed: " .. tostring(digest)
				end
				if #digest == 32 then
					return digest
				end
				if #digest == 64 and digest:match("^%x+$") then
					return (digest:gsub("..", function(pair)
						return string.char(tonumber(pair, 16))
					end))
				end
				return nil, "Executor SHA-256 returned an unsupported digest format"
			end

			local function base64url(binary)
				local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
				local out = {}
				for index = 1, #binary, 3 do
					local a, b, c = string.byte(binary, index, index + 2)
					b = b or 0
					c = c or 0
					local n = a * 65536 + b * 256 + c
					local i1 = math.floor(n / 262144) % 64 + 1
					local i2 = math.floor(n / 4096) % 64 + 1
					local i3 = math.floor(n / 64) % 64 + 1
					local i4 = n % 64 + 1
					out[#out + 1] = alphabet:sub(i1, i1)
					out[#out + 1] = alphabet:sub(i2, i2)
					if index + 1 <= #binary then out[#out + 1] = alphabet:sub(i3, i3) end
					if index + 2 <= #binary then out[#out + 1] = alphabet:sub(i4, i4) end
				end
				return table.concat(out)
			end

			local function create_verifier()
				return http_service:GenerateGUID(false) .. http_service:GenerateGUID(false) .. http_service:GenerateGUID(false)
			end

			local function exchange_token(values)
				local response, request_error = request_http("POST", "https://accounts.spotify.com/api/token", {
					["Content-Type"] = "application/x-www-form-urlencoded",
				}, form_encode(values))
				local code = response_status(response)
				if not response or code < 200 or code >= 300 then
					return nil, response_error(response, request_error)
				end
				local token_data = decode_response(response)
				if type(token_data) ~= "table" or type(token_data.access_token) ~= "string" then
					return nil, "Spotify returned an invalid token response"
				end
				access_token = token_data.access_token
				refresh_token = token_data.refresh_token or refresh_token
				token_expires_at = os.time() + tonumber(token_data.expires_in or 3600)
				return true
			end

			local function refresh_access_token()
				if not refresh_token then
					return false, "Reconnect Spotify to authorize this session"
				end
				return exchange_token({
					client_id = client_id,
					grant_type = "refresh_token",
					refresh_token = refresh_token,
				})
			end

			local function spotify_request(method, endpoint, body, retried)
				if not access_token then
					return false, "Connect Spotify first"
				end
				if token_expires_at <= os.time() + 45 then
					local refreshed, refresh_error = refresh_access_token()
					if not refreshed then
						return false, refresh_error
					end
				end
				local headers = {Authorization = "Bearer " .. access_token}
				if body then
					headers["Content-Type"] = "application/json"
				end
				local response, request_error = request_http(method, "https://api.spotify.com/v1" .. endpoint, headers, body)
				local code = response_status(response)
				if code == 401 and not retried then
					local refreshed, refresh_error = refresh_access_token()
					if not refreshed then
						return false, refresh_error
					end
					return spotify_request(method, endpoint, body, true)
				end
				if not response or (code < 200 or code >= 300) and code ~= 204 then
					return false, response_error(response, request_error)
				end
