		function library:convert_enum(enum)
			local enum_parts = {}
		
			for part in string.gmatch(enum, "[%w_]+") do
				insert(enum_parts, part)
			end
		
			local enum_table = Enum
			for i = 2, #enum_parts do
				local enum_item = enum_table[enum_parts[i]]
		
				enum_table = enum_item
			end
		
			return enum_table
		end

		function library:tween(obj, properties) 
			local tween = tween_service:Create(obj, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, 0, false, 0), properties):Play()
				
			return tween
		end 

		local function get_config_name(value)
			if type(value) ~= "string" then
				return nil
			end

			local name = value:gsub("\\", "/"):match("([^/]+)$") or value
			name = name:gsub("%.[cC][fF][gG]$", "")

			if name == "" or name == "." or name == ".." or name:find("[^%w _%-]") then
				return nil
			end

			return name
		end

		local function get_config_path(name)
			return library.directory .. "/configs/" .. name .. ".cfg"
		end

		function library:config_list_update()
			if not config_holder then return end

			local list = {}
			for _, file in ipairs(listfiles(library.directory .. "/configs")) do
				local normalized = file:gsub("\\", "/")
				local filename = normalized:match("([^/]+)$")
				if filename and filename:lower():match("%.cfg$") then
					local name = get_config_name(filename)
					if name then
						list[#list + 1] = name
					end
				end
			end

			table.sort(list, function(a, b)
				return a:lower() < b:lower()
			end)
			config_holder.refresh_options(list)

			if not auto_load_config_checked then
				auto_load_config_checked = true
				task.defer(function()
					local autoload_path = library.directory .. "/autoload.txt"
					if not isfile(autoload_path) then
						return
					end

					local ok, config_name = pcall(function()
						return get_config_name(readfile(autoload_path))
					end)
					if not ok then
						warn("Failed to read autoload config name: " .. tostring(config_name))
						library:notification({text = "Failed to read autoload config", time = 3})
						return
					end
					if not config_name then
						library:notification({text = "Autoload config name is invalid", time = 3})
						return
					end

					local config_path = get_config_path(config_name)
					if not isfile(config_path) then
						library:notification({text = "Autoload config not found: " .. config_name, time = 3})
						return
					end

					local loaded, err = pcall(function()
						library:load_config(readfile(config_path))
					end)
					if not loaded then
						warn("Failed to load autoload config: " .. tostring(err))
						library:notification({text = "Failed to load autoload config: " .. config_name, time = 3})
						return
					end

					config_holder.set(config_name)
					library:notification({text = "Loaded Autoload Config: " .. config_name, time = 3})
				end)
			end
		end

		function library:get_config()
			local Config = {}
		
			for _, v in flags do
				if type(v) == "table" and v.key then
					Config[_] = {active = v.active, mode = v.mode, key = tostring(v.key)}
				elseif type(v) == "table" and v["Transparency"] ~= nil and v["Color"] ~= nil then
					Config[_] = {Transparency = v["Transparency"], Color = v["Color"]:ToHex()}
				else
					Config[_] = v
				end
			end 
			
			return http_service:JSONEncode(Config)
		end

		function library:load_config(config_json, preserve_old_config) 
			local config = http_service:JSONDecode(config_json)
			if not preserve_old_config then
				library.old_config = library:get_config()
			end
		
			for _, v in next, config do 
				local function_set = library.config_flags[_]
				
				if function_set then 
					if type(v) == "table" and v["Transparency"] ~= nil and v["Color"] ~= nil then
						function_set(hex(v["Color"]), v["Transparency"])
					elseif type(v) == "table" and v["active"] then 
						function_set(v)
					else 
						function_set(v)
					end
				end 
			end 
		end 
		
		function library:round(number, float) 
			local multiplier = 1 / (float or 1)

			return floor(number * multiplier + 0.5) / multiplier
		end 

		function library:apply_theme(instance, theme, property) 
			if not themes.utility[theme] then
				themes.utility[theme] = {}
			end
			if not themes.utility[theme][property] then
				themes.utility[theme][property] = {}
			end
			insert(themes.utility[theme][property], instance)
		end

		function library:update_theme(theme, color)
			for _, property in next, themes.utility[theme] do 

				for m, object in next, property do 
					if object[_] == themes.preset[theme] or object.ClassName == "UIGradient" then
						object[_] = color 
					end
				end 
			end 

			themes.preset[theme] = color 
		end 

		function library:connection(signal, callback)
			local connection = signal:Connect(callback)
			
			insert(library.connections, connection)

			return connection 
		end

		function library:apply_stroke(parent) 
			local stroke = library:create("UIStroke", {
				Parent = parent,
				Color = themes.preset.text_outline, 
				LineJoinMode = Enum.LineJoinMode.Miter
			}) 
			
			library:apply_theme(stroke, "text_outline", "Color")
		end

		function library:create(instance, options)
			local ins = Instance.new(instance) 
			
			for prop, value in next, options do 
				ins[prop] = value
			end
			
			if instance == "TextLabel" or instance == "TextButton" or instance == "TextBox" then 	
				library:apply_theme(ins, "text", "TextColor3")
				library:apply_stroke(ins)
			elseif instance == "ScreenGui" then 
				insert(library.guis, ins)
			end
			
			return ins 
		end
